<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Screenshots (legacy paths) -->
    <files-path
        name="screenshots"
        path="../games/com.mojang/Screenshots/"/>
    <files-path
        name="screenshotsVr"
        path="../games/com.mojang/vr/Screenshots/"/>
    <files-path
        name="screenshotsTrial"
        path="../games/com.mojang.trial/Screenshots/"/>
    <files-path
        name="screenshotsVrTrial"
        path="../games/com.mojang.trial/vr/Screenshots/"/>

    <external-files-path
        name="screenshotsExternal"
        path="games/com.mojang/Screenshots"/>
    <external-files-path
        name="screenshotsExternalVr"
        path="games/com.mojang/vr/Screenshots"/>
    <external-files-path
        name="screenshotsExternalTrial"
        path="games/com.mojang.trial/Screenshots"/>
    <external-files-path
        name="screenshotsExternalVrTrial"
        path="games/com.mojang.trial/vr/Screenshots"/>

    <external-path
        name="screenshotsExternalLegacy"
        path="games/com.mojang/Screenshots"/>
    <external-path
        name="screenshotsExternalLegacyVr"
        path="games/com.mojang/vr/Screenshots"/>
    <external-path
        name="screenshotsExternalLegacyTrial"
        path="games/com.mojang.trial/Screenshots"/>
    <external-path
        name="screenshotsExternalLegacyVrTrial"
        path="games/com.mojang.trial/vr/Screenshots"/>

    <!-- Full internal/external storage access for other apps -->
    <external-cache-path
        name="external_cache"
        path="."/>
    <cache-path
        name="cache"
        path="."/>
    <external-files-path
        name="external_files"
        path="."/>
    <files-path
        name="files"
        path="."/>

    <!-- Android/media app root (mods, resources, minecraft data) -->
    <external-path
        name="media_root"
        path="."/>

    <!-- Legacy games/org.levimc directory -->
    <external-path
        name="legacy_root"
        path="games/org.levimc/"/>
</paths>
